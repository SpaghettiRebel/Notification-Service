# Copy to .env in the repository root. `go run ./cmd/...` reads it from the
# working directory, and Docker Compose uses it for variable substitution.
# Inside the compose network the PostgreSQL and Kafka addresses are fixed,
# so the localhost values below only apply to local runs.

DB_HOST=localhost
DB_PORT=5433
DB_USER=user
DB_PASS=password
DB_NAME=notification_db

KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_DELIVERY_TIMEOUT_MS=10000
KAFKA_MAX_POLL_INTERVAL_MS=180000

PROCESSING_LEASE_SECONDS=60
SENDER_MAX_ATTEMPTS=3
SENDER_ATTEMPT_TIMEOUT_SECONDS=10
SENDER_RETRY_MIN_SECONDS=1
SENDER_RETRY_MAX_SECONDS=5

APP_HOST=0.0.0.0
APP_PORT=8001
